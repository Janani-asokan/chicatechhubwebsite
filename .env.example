# Copy to .env.local for local development.
# Without DATABASE_URL the app uses an embedded local Postgres (PGlite) stored in .data/
# DATABASE_URL=postgres://user:pass@host:5432/db

# Long random string used to sign the admin login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Password for /admin
ADMIN_PASSWORD=change-me

# Optional: Discord or Slack webhook URL to get notified of new enquiries
# NOTIFY_WEBHOOK_URL=
